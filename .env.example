APP_NAME=MiSMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Full RTSP URL for the ONVIF camera stream, e.g.
# rtsp://admin:password@192.168.1.101:8554/Streaming/Channels/102
#
# Many ONVIF/Hikvision-style cameras expose two streams per channel:
# Channels/101 is the full-resolution main stream, Channels/102 is a
# lower-resolution sub-stream. Prefer the sub-stream here - transcoding a
# high-resolution main stream (e.g. 2560x1440) to H.264 live can be too
# slow to keep up in real time and will make the feed stall.
ONVIF_STREAM_URL=
ONVIF_FFMPEG_BINARY=ffmpeg
# Safety cap: frames wider than this are scaled down before encoding,
# regardless of which stream ONVIF_STREAM_URL points at.
ONVIF_STREAM_MAX_WIDTH=960
# ffmpeg's H.264 -crf value (0-51, lower = better quality/bigger frames).
ONVIF_STREAM_QUALITY=23

# The dev server (`php artisan serve`) handles one request at a time by
# default. /cameras/feed holds its connection open for as long as it's being
# watched, and every other request - other pages, their CSS/assets, even
# unrelated routes in other tabs - shares this same fixed worker pool. Too
# low a number here and simply leaving a camera feed open starves the rest
# of the site until you close it. This must stay uncommented, and
# `php artisan serve` must be run with --no-reload for it to take effect.
PHP_CLI_SERVER_WORKERS=16

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
